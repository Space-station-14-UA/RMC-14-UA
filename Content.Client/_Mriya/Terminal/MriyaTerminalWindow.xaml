<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="Корпоративний термінал"
               Resizable="False"
               MinWidth="500"
               MinHeight="400">
    <PanelContainer VerticalExpand="True" HorizontalExpand="True">
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#06180D" BorderColor="#0F3F22" BorderThickness="2"/>
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="10" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="MainPage" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <PanelContainer HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#0A2415" BorderColor="#0F3F22" BorderThickness="1"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Horizontal" Margin="8 4" HorizontalExpand="True">
                        <Label Name="OperatorLabel" Text="ОПЕРАТОР:" VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                            <Label Name="OperatorNameLabel" Text="НЕВІДОМИЙ" ClipText="True"/>
                            <Label Name="OperatorJobLabel" Text="—" ClipText="True"/>
                        </BoxContainer>
                        <Button Name="HistoryButton" Text="ІСТОРІЯ" MinWidth="90" VerticalAlignment="Center"/>
                    </BoxContainer>
                </PanelContainer>
                <ScrollContainer Name="Scroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="2 8 2 8">
                    <RichTextLabel Name="MessageHistory" VerticalAlignment="Top" HorizontalExpand="True"/>
                </ScrollContainer>
                <BoxContainer Name="InputContainer" Orientation="Horizontal" Visible="False" Margin="0 4 0 0">
                    <LineEdit Name="InputBar" HorizontalExpand="True" PlaceHolder="Введіть повідомлення..."/>
                    <Button Name="SendButton" Text="НАДІСЛАТИ" Margin="6 0 0 0"/>
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Name="HistoryPage" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Visible="False">
                <PanelContainer HorizontalExpand="True">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#0A2415" BorderColor="#0F3F22" BorderThickness="1"/>
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Horizontal" Margin="8 4" HorizontalExpand="True">
                        <Label Name="HistoryTitleLabel" Text="ІСТОРІЯ" HorizontalExpand="True" VerticalAlignment="Center"/>
                        <Button Name="BackButton" Text="ПОВЕРНУТИСЯ" MinWidth="110"/>
                    </BoxContainer>
                </PanelContainer>
                <ScrollContainer Name="HistoryScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False" Margin="2 8 2 2">
                    <RichTextLabel Name="HistoryMessages" VerticalAlignment="Top" HorizontalExpand="True"/>
                </ScrollContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
