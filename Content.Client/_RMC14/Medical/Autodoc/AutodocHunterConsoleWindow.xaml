<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="Авто-лікар" MinSize="500 650">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#111111" BorderColor="#880000" BorderThickness="2" />
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Vertical" Margin="15">
            <!-- Empty State -->
            <BoxContainer Name="EmptyPanel" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                <Control VerticalExpand="True" />
                <Label Text="Пацієнта не виявлено" Align="Center" StyleClasses="LabelBig" FontColorOverride="#880000" />
                <Control VerticalExpand="True" />
            </BoxContainer>

            <!-- Occupant State -->
            <BoxContainer Name="OccupantPanel" Orientation="Vertical">
                <!-- Occupant Section -->
                <BoxContainer Orientation="Vertical" Margin="0 0 0 10">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="Пацієнт:" MinWidth="110" FontColorOverride="#880000" StyleClasses="LabelKeyText" />
                        <Label Name="OccupantNameLabel" Text="" StyleClasses="LabelBig" FontColorOverride="#E5B107" />
                    </BoxContainer>
                    
                    <cc:HSeparator Color="#880000" Margin="0 4 0 8" />
                    
                    <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                        <Label Text="Здоров'я:" MinWidth="110" FontColorOverride="#888888" />
                        <ProgressBar Name="HealthBar" HorizontalExpand="True" MinValue="0" MinHeight="16">
                            <Label Name="HealthBarText" Align="Right" Margin="0 0 5 0" />
                        </ProgressBar>
                    </BoxContainer>

                    <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                        <Label Text="Статус:" MinWidth="110" FontColorOverride="#888888" />
                        <Label Name="StatusLabel" Text="" />
                    </BoxContainer>

                    <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                        <Label Text="Рівень крові:" MinWidth="110" FontColorOverride="#888888" />
                        <ProgressBar Name="BloodBar" HorizontalExpand="True" MinValue="0" MaxValue="100" MinHeight="16">
                            <Label Name="BloodBarText" Align="Right" Margin="0 0 5 0" />
                        </ProgressBar>
                    </BoxContainer>

                    <!-- Hidden but defined to satisfy code-behind references -->
                    <BoxContainer Visible="False">
                        <Label Name="PulseLabel" />
                        <ProgressBar Name="ReagentsBar">
                            <Label Name="ReagentsBarText" />
                        </ProgressBar>
                    </BoxContainer>
                </BoxContainer>

                <!-- Damage Section -->
                <BoxContainer Orientation="Vertical" Margin="0 0 0 10">
                    <Label Text="Пошкодження" StyleClasses="LabelKeyText" FontColorOverride="#880000" />
                    <cc:HSeparator Color="#880000" Margin="0 4 0 8" />
                    
                    <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                        <Label Text="Механічне:" MinWidth="110" FontColorOverride="#888888" />
                        <ProgressBar Name="BruteBar" HorizontalExpand="True" MinValue="0" MaxValue="100" MinHeight="16">
                            <Label Name="BruteBarText" Align="Right" Margin="0 0 5 0" />
                        </ProgressBar>
                    </BoxContainer>
                    
                    <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                        <Label Text="Опіки:" MinWidth="110" FontColorOverride="#888888" />
                        <ProgressBar Name="BurnBar" HorizontalExpand="True" MinValue="0" MaxValue="100" MinHeight="16">
                            <Label Name="BurnBarText" Align="Right" Margin="0 0 5 0" />
                        </ProgressBar>
                    </BoxContainer>
                    
                    <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                        <Label Text="Токсини:" MinWidth="110" FontColorOverride="#888888" />
                        <ProgressBar Name="ToxinBar" HorizontalExpand="True" MinValue="0" MaxValue="100" MinHeight="16">
                            <Label Name="ToxinBarText" Align="Right" Margin="0 0 5 0" />
                        </ProgressBar>
                    </BoxContainer>
                    
                    <BoxContainer Orientation="Horizontal" Margin="0 2 0 2">
                        <Label Text="Кисень:" MinWidth="110" FontColorOverride="#888888" />
                        <ProgressBar Name="OxygenBar" HorizontalExpand="True" MinValue="0" MaxValue="100" MinHeight="16">
                            <Label Name="OxygenBarText" Align="Right" Margin="0 0 5 0" />
                        </ProgressBar>
                    </BoxContainer>
                </BoxContainer>

                <!-- Control Actions Button (Start Surgery) -->
                <BoxContainer Orientation="Vertical" Margin="0 5 0 10">
                    <cc:HSeparator Color="#880000" />
                    <BoxContainer Orientation="Horizontal" Margin="0 10 0 5">
                        <Button Name="StartSurgeryButton" Text="Розпочати операцію" HorizontalExpand="True" MinHeight="50" Margin="2" />
                        <BoxContainer Orientation="Horizontal" Margin="10 0 0 0">
                            <Button Name="EjectButton" Text="Витягти" MinWidth="100" Margin="2" />
                        </BoxContainer>
                    </BoxContainer>
                    <!-- Hidden elements required by code-behind -->
                    <BoxContainer Visible="False">
                        <Button Name="ClearButton" />
                        <Button Name="ImportScanButton" />
                    </BoxContainer>
                </BoxContainer>

                <!-- Treatment Section -->
                <BoxContainer Orientation="Vertical" Margin="0 0 0 10">
                    <Label Text="Лікування" StyleClasses="LabelKeyText" FontColorOverride="#880000" />
                    <cc:HSeparator Color="#880000" Margin="0 4 0 8" />
                    <BoxContainer Orientation="Horizontal">
                        <Button Name="BruteToggleButton" Text="Лікування механічних пошкоджень" ToggleMode="True" HorizontalExpand="True" Margin="2" />
                        <Button Name="BurnToggleButton" Text="Лікування термо-пошкоджень" ToggleMode="True" HorizontalExpand="True" Margin="2" />
                    </BoxContainer>
                    
                    <!-- Hidden elements required by code-behind -->
                    <BoxContainer Visible="False">
                        <Button Name="CloseIncisionsToggleButton" ToggleMode="True" />
                        <Button Name="RemoveShrapnelToggleButton" ToggleMode="True" />
                    </BoxContainer>
                </BoxContainer>

                <!-- Blood Section -->
                <BoxContainer Orientation="Vertical" Margin="0 0 0 10">
                    <Label Text="Кров" StyleClasses="LabelKeyText" FontColorOverride="#880000" />
                    <cc:HSeparator Color="#880000" Margin="0 4 0 8" />
                    <BoxContainer Orientation="Horizontal">
                        <Button Name="BloodToggleButton" Text="Стабілізувати рівень крові" ToggleMode="True" HorizontalExpand="True" Margin="2" />
                        <Button Name="DialysisToggleButton" Text="Діаліз" ToggleMode="True" HorizontalExpand="True" Margin="2" />
                        <Button Name="ToxinToggleButton" Text="Детоксикація" ToggleMode="True" HorizontalExpand="True" Margin="2" />
                    </BoxContainer>
                </BoxContainer>

                <!-- Orthopedic/Surgical Section -->
                <BoxContainer Name="OrthopedicSection" Orientation="Vertical" Margin="0 0 0 10">
                    <Label Text="Хірургічні операції" StyleClasses="LabelKeyText" FontColorOverride="#880000" />
                    <cc:HSeparator Color="#880000" Margin="0 4 0 8" />
                    <BoxContainer Orientation="Horizontal">
                        <Button Name="InternalBleedingToggleButton" Text="Внутрішня кровотеча" ToggleMode="True" HorizontalExpand="True" Margin="2" />
                        <Button Name="BrokenBoneToggleButton" Text="Перелом кісток" ToggleMode="True" HorizontalExpand="True" Margin="2" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Button Name="OrganDamageToggleButton" Text="Пошкодження органів" ToggleMode="True" HorizontalExpand="True" Margin="2" />
                        <Button Name="LarvaToggleButton" Text="Видалення ембріона" ToggleMode="True" HorizontalExpand="True" Margin="2" />
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
